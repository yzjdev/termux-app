<?xml version="1.0" encoding="utf-8"?>
<!-- AtomCode 模型编辑对话框：模型基本信息 + 可展开的新建 Provider 账号表单。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/atomcode_model_id_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_edit_model_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_model_id_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_model_account_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- 账号下拉：只列出配置中已有的 provider_accounts，不含任何密钥。 -->
        <AutoCompleteTextView
            android:id="@+id/atomcode_edit_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="0"
            android:hint="@string/atomcode_model_account_hint"
            android:inputType="none"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/atomcode_edit_new_account_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/atomcode_new_account_label"
            android:textSize="13sp" />

        <!-- 新建账号表单：仅在勾选「新建 Provider 账号」时显示。 -->
        <LinearLayout
            android:id="@+id/atomcode_edit_new_account_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/atomcode_edit_account_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/atomcode_account_name_label"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/atomcode_edit_account_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/atomcode_account_provider_hint"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/atomcode_edit_account_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/atomcode_account_base_url_hint"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/atomcode_edit_account_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/atomcode_account_api_key_hint"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_model_name_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_edit_model_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_model_name_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_model_context_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_edit_context_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_model_context_hint"
            android:inputType="number"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_model_reasoning_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_edit_reasoning_levels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_model_reasoning_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/atomcode_edit_vision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/atomcode_model_vision_label"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
