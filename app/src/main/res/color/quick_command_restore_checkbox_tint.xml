<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮快捷指令弹窗（深色背景）上恢复页勾选框的着色：
     选中时使用绿色以突出选择，未选中时半透明白，已存在（禁用）时用灰色降低存在感。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/quick_command_toggle_inactive" />
    <item android:state_checked="true" android:color="@color/quick_command_restore_checkbox_checked" />
    <item android:color="@color/quick_command_overlay_secondary" />
</selector>
