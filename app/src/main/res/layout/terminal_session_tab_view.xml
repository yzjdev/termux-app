<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:minWidth="48dp"
    android:minHeight="34dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/terminal_session_tab_background"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <!-- 会话编号徽标（正圆药丸） -->
    <TextView
        android:id="@+id/terminal_session_tab_number"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:gravity="center"
        android:background="@drawable/terminal_session_tab_number_background"
        android:textColor="@color/terminal_session_tab_number_color"
        android:textSize="10sp"
        android:textStyle="bold"
        android:duplicateParentState="true" />

    <!-- 会话标题 -->
    <TextView
        android:id="@+id/terminal_session_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="180dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:textColor="@color/terminal_session_tab_title_color"
        android:textSize="12sp"
        android:duplicateParentState="true" />

    <!-- 关闭按钮 -->
    <ImageView
        android:id="@+id/terminal_session_tab_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        android:tint="@color/terminal_session_tab_close_color"
        android:duplicateParentState="true"
        android:contentDescription="@string/action_close_session" />

</LinearLayout>
