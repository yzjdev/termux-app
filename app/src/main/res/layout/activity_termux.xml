<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true">

            <LinearLayout
                android:id="@+id/terminal_content_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/black">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/terminal_sessions_tab_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/black"
                        app:tabBackground="@android:color/transparent"
                        app:tabGravity="start"
                        app:tabIndicatorHeight="0dp"
                        app:tabMode="scrollable"
                        app:tabPaddingEnd="0dp"
                        app:tabPaddingStart="0dp"
                        app:tabMinWidth="0dp"
                        app:tabRippleColor="@android:color/transparent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_tab_session_button"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="20dp"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                <LinearLayout
                    android:id="@+id/terminal_toolbar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.viewpager.widget.ViewPager
                        android:id="@+id/terminal_toolbar_view_pager"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="37.5dp"
                        android:background="@color/black" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:clickable="true"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <!-- 三个存储目录竖向排列，各自是独立收展的手风琴卡片（可同时展开）。 -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 内部存储 -->
                        <LinearLayout
                            android:id="@+id/drawer_storage_card_files"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/drawer_section_card_background"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/drawer_icon_chip_background">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_drawer_folder"
                                        android:tint="?attr/termuxActivityDrawerImageTint" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="内部存储"
                                        android:textColor="?attr/termuxActivityDrawerImageTint"
                                        android:textSize="15sp" />

                                    <TextView
                                        android:id="@+id/drawer_storage_path_files"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="start"
                                        android:singleLine="true"
                                        android:textColor="@color/drawer_section_title"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/drawer_storage_back_button_files"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:contentDescription="@string/action_drawer_parent_dir"
                                    app:icon="@drawable/ic_arrow_up"
                                    app:iconSize="20dp"
                                    app:iconTint="?attr/termuxActivityDrawerImageTint" />

                                <ImageView
                                    android:id="@+id/drawer_storage_expand_chevron_files"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="2dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_drawer_expand"
                                    android:tint="@color/drawer_section_title" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/drawer_storage_list_view_files"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:clipToPadding="false"
                                android:overScrollMode="never" />
                        </LinearLayout>

                        <!-- 外部存储 -->
                        <LinearLayout
                            android:id="@+id/drawer_storage_card_external_files"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/drawer_section_card_background"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/drawer_icon_chip_background">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_drawer_folder"
                                        android:tint="?attr/termuxActivityDrawerImageTint" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="外部存储"
                                        android:textColor="?attr/termuxActivityDrawerImageTint"
                                        android:textSize="15sp" />

                                    <TextView
                                        android:id="@+id/drawer_storage_path_external_files"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="start"
                                        android:singleLine="true"
                                        android:textColor="@color/drawer_section_title"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/drawer_storage_back_button_external_files"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:contentDescription="@string/action_drawer_parent_dir"
                                    app:icon="@drawable/ic_arrow_up"
                                    app:iconSize="20dp"
                                    app:iconTint="?attr/termuxActivityDrawerImageTint" />

                                <ImageView
                                    android:id="@+id/drawer_storage_expand_chevron_external_files"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="2dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_drawer_expand"
                                    android:tint="@color/drawer_section_title" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/drawer_storage_list_view_external_files"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:clipToPadding="false"
                                android:overScrollMode="never" />
                        </LinearLayout>

                        <!-- 共享存储 -->
                        <LinearLayout
                            android:id="@+id/drawer_storage_card_external_shared"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/drawer_section_card_background"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="10dp">

                                <FrameLayout
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/drawer_icon_chip_background">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_drawer_folder"
                                        android:tint="?attr/termuxActivityDrawerImageTint" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:singleLine="true"
                                        android:text="共享存储"
                                        android:textColor="?attr/termuxActivityDrawerImageTint"
                                        android:textSize="15sp" />

                                    <TextView
                                        android:id="@+id/drawer_storage_path_external_shared"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="start"
                                        android:singleLine="true"
                                        android:textColor="@color/drawer_section_title"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/drawer_storage_back_button_external_shared"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:contentDescription="@string/action_drawer_parent_dir"
                                    app:icon="@drawable/ic_arrow_up"
                                    app:iconSize="20dp"
                                    app:iconTint="?attr/termuxActivityDrawerImageTint" />

                                <ImageView
                                    android:id="@+id/drawer_storage_expand_chevron_external_shared"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="2dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_drawer_expand"
                                    android:tint="@color/drawer_section_title" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/drawer_storage_list_view_external_shared"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:clipToPadding="false"
                                android:overScrollMode="never" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>

                <!-- 底部：设置按钮（图标 + 文字的胶囊按钮） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/action_drawer_settings"
                    android:textSize="13sp"
                    android:contentDescription="@string/action_open_settings"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="20dp"
                    app:iconTint="?attr/termuxActivityDrawerImageTint" />
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
