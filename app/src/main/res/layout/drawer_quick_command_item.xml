<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="2dp"
    android:background="@drawable/drawer_list_item_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/quick_command_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:tint="?attr/termuxActivityDrawerImageTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quick_command_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/termuxActivityDrawerImageTint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/quick_command_command_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/drawer_section_title"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/quick_command_run_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_drawer_play"
            android:tint="?attr/termuxActivityDrawerImageTint"
            android:background="@drawable/drawer_list_item_background" />
    </LinearLayout>

    <!-- 每个指令的执行方式开关：悬浮终端执行 / 后台完成后弹窗提示结果。
         缩进与上方标题文字对齐：图标 22dp + 间距 12dp，再减去图标自身 4dp 内边距。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/quick_command_toggle_floating_terminal"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/quick_command_toggle_background"
            android:contentDescription="@string/quick_command_toggle_floating_terminal_hint"
            android:padding="4dp"
            android:src="@drawable/ic_quick_command_floating_terminal"
            android:tint="@color/quick_command_toggle_tint" />

        <TextView
            android:id="@+id/quick_command_toggle_floating_terminal_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="@string/quick_command_toggle_floating_short"
            android:textColor="@color/quick_command_toggle_tint"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/quick_command_toggle_notify_result"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/quick_command_toggle_background"
            android:contentDescription="@string/quick_command_toggle_notify_result_hint"
            android:padding="4dp"
            android:src="@drawable/ic_quick_command_notify"
            android:tint="@color/quick_command_toggle_tint" />

        <TextView
            android:id="@+id/quick_command_toggle_notify_result_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="@string/quick_command_toggle_notify_short"
            android:textColor="@color/quick_command_toggle_tint"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
