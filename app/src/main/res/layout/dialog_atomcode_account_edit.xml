<?xml version="1.0" encoding="utf-8"?>
<!-- Provider 账号编辑对话框：名称、协议、Base URL、API Key。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/atomcode_account_name_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_account_edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_account_provider_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_account_edit_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_account_provider_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_account_base_url_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_account_edit_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_account_base_url_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/atomcode_account_api_key_label"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/atomcode_account_edit_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/atomcode_account_api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/atomcode_account_edit_clear_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/action_clear_atomcode_api_key"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
