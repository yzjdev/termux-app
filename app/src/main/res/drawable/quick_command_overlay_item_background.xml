<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮快捷指令弹窗的列表项卡片背景：深色面板上用微亮白色，按压态更亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/quick_command_overlay_item_background_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/quick_command_overlay_item_background" />
        </shape>
    </item>
</selector>
