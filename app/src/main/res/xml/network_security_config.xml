<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted so that a provider account can point at a self-hosted
  OpenAI-compatible server, which commonly only speaks plain HTTP on a LAN address
  (e.g. http://192.168.1.10:11434/v1). The host cannot be listed here ahead of time
  because base_url is entered by the user, so the permission has to be app wide.

  Nothing is downgraded by this: every URL the app itself uses is HTTPS, and the default
  trust anchors still apply, so a cleartext connection only happens when the user types an
  http:// base_url for a provider account.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
