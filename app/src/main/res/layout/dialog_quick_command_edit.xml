<?xml version="1.0" encoding="utf-8"?>
<!-- 添加/编辑快捷指令的悬浮面板：与快捷指令面板、悬浮终端一致的深色浮层，
     标题栏可拖动，底部为确定/取消按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_quick_command_edit_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_panel_background"
    android:elevation="16dp">

    <LinearLayout
        android:id="@+id/floating_quick_command_edit_titlebar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:background="@drawable/floating_terminal_titlebar">

        <TextView
            android:id="@+id/floating_quick_command_edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/title_add_quick_command"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/floating_quick_command_edit_close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/quick_command_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_command_name_label"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/quick_command_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quick_command_name_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/quick_command_overlay_title"
            android:textColorHint="@color/quick_command_overlay_secondary"
            android:backgroundTint="@color/quick_command_overlay_secondary" />

        <TextView
            android:id="@+id/quick_command_command_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/quick_command_command_label"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/quick_command_command_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/quick_command_command_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="6"
            android:textColor="@color/quick_command_overlay_title"
            android:textColorHint="@color/quick_command_overlay_secondary"
            android:backgroundTint="@color/quick_command_overlay_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_command_edit_cancel_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@android:string/cancel"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_command_edit_ok_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@android:string/ok"
            android:textColor="@color/quick_command_overlay_title"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
