<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮终端面板：应用内浮层，固定半屏高，标题栏可拖动 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_terminal_panel"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="vertical"
    android:background="@drawable/floating_panel_background"
    android:elevation="20dp">

    <LinearLayout
        android:id="@+id/floating_terminal_titlebar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:background="@drawable/floating_terminal_titlebar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_drawer_folder"
            app:tint="@color/quick_command_overlay_secondary" />

        <TextView
            android:id="@+id/floating_terminal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="middle"
            android:letterSpacing="0.02"
            android:text="@string/title_quick_command_running"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/floating_terminal_rerun_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_rerun_floating_terminal"
            android:src="@drawable/ic_drawer_play"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/floating_terminal_minimize_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_minimize_floating_terminal"
            android:src="@drawable/ic_quick_command_minimize"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/floating_terminal_close_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quick_command_overlay_divider" />

    <com.termux.view.TerminalView
        android:id="@+id/floating_terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp"
        android:focusableInTouchMode="true" />
</LinearLayout>
