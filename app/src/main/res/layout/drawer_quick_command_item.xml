<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="2dp"
    android:background="@drawable/drawer_list_item_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/quick_command_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:tint="?attr/termuxActivityDrawerImageTint" />

    <TextView
        android:id="@+id/quick_command_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="?attr/termuxActivityDrawerImageTint"
        android:textSize="14sp" />
</LinearLayout>
