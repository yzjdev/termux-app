<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷指令与添加/编辑指令共用的悬浮面板：标题栏固定，内容区在“列表页/编辑页”之间切换，
     拖动与位置在两个页面间保持。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_quick_commands_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_panel_background"
    android:elevation="20dp">

    <LinearLayout
        android:id="@+id/floating_quick_commands_titlebar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:background="@drawable/floating_terminal_titlebar">

        <TextView
            android:id="@+id/floating_quick_commands_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:text="@string/title_quick_commands"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/floating_quick_command_add_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/action_add_quick_command"
            android:textColor="@color/quick_command_overlay_title"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/floating_quick_commands_reset_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/action_restore_quick_commands"
            android:textColor="@color/quick_command_overlay_title"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quick_command_restore_select_all_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="@string/action_select_all_quick_commands"
            android:textColor="@color/quick_command_overlay_title"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/floating_quick_commands_close_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- 标题栏与内容区之间的细分隔线，让深色面板更有层次 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/quick_command_overlay_divider" />

    <!-- 列表页：指令列表（含空状态）+ 添加按钮 -->
    <LinearLayout
        android:id="@+id/floating_quick_commands_list_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/floating_quick_commands_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/floating_quick_commands_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/msg_quick_commands_empty"
                android:textColor="@color/quick_command_overlay_empty"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 恢复默认页：列出内置默认指令，由用户勾选要恢复到列表的项 -->
    <LinearLayout
        android:id="@+id/floating_quick_command_restore_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/msg_quick_command_restore_hint"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/floating_quick_command_restore_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="4dp"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/floating_quick_command_restore_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/quick_command_overlay_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_command_restore_cancel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@android:string/cancel"
                android:textColor="@color/quick_command_overlay_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_command_restore_ok_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_restore_quick_commands"
                android:textColor="@color/quick_command_overlay_title"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 编辑页：与列表页共用同一个面板，保存/取消后回到列表页 -->
    <LinearLayout
        android:id="@+id/floating_quick_command_edit_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/quick_command_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_command_name_label"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/quick_command_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:hint="@string/quick_command_name_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/quick_command_overlay_title"
            android:textColorHint="@color/quick_command_overlay_secondary"
            android:textSize="14sp"
            android:backgroundTint="@color/quick_command_overlay_secondary" />

        <TextView
            android:id="@+id/quick_command_command_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/quick_command_command_label"
            android:textColor="@color/quick_command_overlay_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/quick_command_command_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="top"
            android:hint="@string/quick_command_command_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="6"
            android:textColor="@color/quick_command_overlay_title"
            android:textColorHint="@color/quick_command_overlay_secondary"
            android:textSize="14sp"
            android:backgroundTint="@color/quick_command_overlay_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="@color/quick_command_overlay_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_command_edit_cancel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@android:string/cancel"
                android:textColor="@color/quick_command_overlay_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_command_edit_ok_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@android:string/ok"
                android:textColor="@color/quick_command_overlay_title"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 操作页：点击卡片后在本面板内选择运行/编辑/删除 -->
    <LinearLayout
        android:id="@+id/floating_quick_command_actions_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/quick_command_action_run"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_drawer_play"
                app:tint="@color/quick_command_overlay_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/action_run_quick_command"
                android:textColor="@color/quick_command_overlay_title"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_command_action_edit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quick_command_edit"
                app:tint="@color/quick_command_overlay_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/action_edit_quick_command"
                android:textColor="@color/quick_command_overlay_title"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_command_action_delete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quick_command_delete"
                app:tint="@color/quick_command_overlay_danger" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/action_delete_quick_command"
                android:textColor="@color/quick_command_overlay_danger"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
